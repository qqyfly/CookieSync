{
  "name": "cookiesync",
  "private": true,
  "version": "0.1.0",
  "description": "A Chrome extension for managing a user-selected website list.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config vite.config.chrome.ts",
    "build": "vite build --config vite.config.chrome.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.39.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
