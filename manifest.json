{
  "manifest_version": 3,
  "name": "CookieSync",
  "version": "0.1.0",
  "description": "Manage the websites selected for a future, user-controlled sync workflow.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CookieSync",
    "default_popup": "src/pages/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["storage"]
}
